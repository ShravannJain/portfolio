---
const { title } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;700&display=swap" rel="stylesheet" />
    <script is:inline>
      // Set theme before paint to avoid flash
      const saved = localStorage.getItem('theme');
      if (saved === 'light') document.documentElement.setAttribute('data-theme', 'light');
    </script>
    <style is:global>
      :root {
        --bg: #111111;
        --text: #e8e8e8;
        --muted: #8a8a8a;
        --line: #2a2a2a;
        --accent: #4ade80;
      }
      :root[data-theme="light"] {
        --bg: #fafafa;
        --text: #1a1a1a;
        --muted: #666666;
        --line: #e0e0e0;
        --accent: #16a34a;
      }
      * { box-sizing: border-box; }
      html { background: var(--bg); }
      body {
        background: var(--bg);
        color: var(--text);
        max-width: 700px;
        margin: 0 auto;
        padding: 3rem 1.5rem 4rem;
        font-family: 'Inter', system-ui, sans-serif;
        line-height: 1.6;
        transition: background 0.15s ease, color 0.15s ease;
      }
      .mono { font-family: 'JetBrains Mono', monospace; }
      h1 { font-size: 1.9rem; margin: 0 0 0.25rem; }
      .subtitle {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        color: var(--muted);
        text-transform: uppercase;
        margin-bottom: 1.5rem;
      }
      p { color: var(--text); opacity: 0.85; }
      a { color: var(--text); text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; }
      a:hover { text-decoration-color: var(--accent); }
      .section { margin-top: 3rem; }
      .section-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        color: var(--muted);
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
      }
      .section-label::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--line);
      }
      nav {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 2.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--line);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
      }
      nav a { text-decoration: none; color: var(--muted); }
      nav a:hover { color: var(--text); }
      .theme-toggle {
        margin-left: auto;
        background: none;
        border: 1px solid var(--line);
        border-radius: 6px;
        color: var(--muted);
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.9rem;
      }
      .theme-toggle:hover { color: var(--text); border-color: var(--muted); }
      footer {
        margin-top: 4rem;
        padding-top: 1rem;
        border-top: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: var(--muted);
      }
      .social-links {
        display: flex;
        gap: 1rem;
      }
      .social-links a {
        color: var(--muted);
        text-decoration: none;
        display: flex;
        align-items: center;
      }
      .social-links a:hover { color: var(--text); }
      .social-links svg { width: 18px; height: 18px; }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">home</a>
      <a href="/projects">projects</a>
      <a href="/writings">writings</a>
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">◐</button>
    </nav>
    <slot />
    <footer>
      <span>© 2026 Shravan Jain</span>
      <div class="social-links">
        <a href="https://github.com/ShravannJain" aria-label="GitHub" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.17-.01-2.12-3.2.7-3.87-1.36-3.87-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.69 5.38-5.25 5.67.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.66.79.55A10.51 10.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/shravanjain1" aria-label="LinkedIn" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.15 1.45-2.15 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z"/></svg>
        </a>
        <a href="mailto:shravan.jain59r@gmail.com" aria-label="Email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 6 10 7 10-7"/></svg>
        </a>
      </div>
    </footer>
    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      btn.addEventListener('click', () => {
        const isLight = document.documentElement.getAttribute('data-theme') === 'light';
        if (isLight) {
          document.documentElement.removeAttribute('data-theme');
          localStorage.setItem('theme', 'dark');
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
          localStorage.setItem('theme', 'light');
        }
      });
    </script>
  </body>
</html>