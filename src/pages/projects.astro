---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Projects">
<h1>Projects</h1>

<div class="section">
  <div class="project-card">
    <div class="project-header">
      <h3>Mnemos-jrnl</h3>
      <span class="status-dot"></span>
    </div>
    <p class="project-desc">
      A minimalist journaling app with a dark editorial UI. Spring Boot +
      MongoDB backend, React frontend, fully containerized with Docker
      and shipped through a CI/CD pipeline on every push.
    </p>
    <div class="tech-stack">
      <span class="tech-tag">Spring Boot</span>
      <span class="tech-tag">React</span>
      <span class="tech-tag">MongoDB</span>
      <span class="tech-tag">Docker</span>
    </div>
    <a href="https://github.com/ShravannJain/Mnemos-jrnl" class="arrow-link" target="_blank" rel="noopener">
      View on GitHub <span class="arrow">→</span>
    </a>
  </div>

  <div class="coming-soon">
    <span class="status-dot"></span>
    <p>
      Bro's cooking cool stuffs rn.
    </p>
  </div>

  <a href="https://github.com/ShravannJain" class="arrow-link" target="_blank" rel="noopener">
    Check out other projects here <span class="arrow">→</span>
  </a>
</div>
</Layout>

<style>
.project-card {
    border: 1px solid var(--text);
    border-opacity: 0.15;
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
    transition: border-color 0.15s ease, transform 0.15s ease;
}
.project-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
}
.project-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
}
.project-header h3 {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.05rem;
    margin: 0;
    color: var(--text);
}
.project-desc {
    color: var(--text);
    opacity: 0.85;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0.5rem 0 1rem;
}
.tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
}
.tech-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--text);
    border-radius: 999px;
    opacity: 0.7;
}
.coming-soon {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: var(--text);
    opacity: 0.85;
}
.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    margin-top: 0.5rem;
    flex-shrink: 0;
    animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
}
.arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--text);
    padding-bottom: 2px;
    transition: gap 0.15s ease, border-color 0.15s ease, color 0.15s ease;
}
.arrow-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    gap: 0.6rem;
}
</style>