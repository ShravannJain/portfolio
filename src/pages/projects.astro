---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Projects">
  <h1>Projects</h1>

  <div class="section">
    <div class="coming-soon">
      <span class="status-dot"></span>
      <p>
        Dev is cooking something. Full write-ups on backend and full-stack
        projects will be live in this feed shortly.
      </p>
    </div>

    <a href="https://github.com/ShravannJain" class="arrow-link" target="_blank" rel="noopener">
      See the code on GitHub <span class="arrow">→</span>
    </a>
  </div>
</Layout>

<style>
  .coming-soon {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: var(--text);
    opacity: 0.85;
  }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    margin-top: 0.5rem;
    flex-shrink: 0;
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--text);
    padding-bottom: 2px;
    transition: gap 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .arrow-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    gap: 0.6rem;
  }
</style>
